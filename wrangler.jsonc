{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swcreate-identity-api",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "routes": [
    { "pattern": "api.swcreate.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "swcreate-identity",
      "database_id": "f99e0025-196b-4b12-924f-5c7ada2a02c4",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
